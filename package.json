{
  "name": "dsh-session-admin",
  "version": "0.1.0",
  "type": "module",
  "description": "Manage archived DSH sessions: batch unarchive and permanent deletion with a safe attachment reference scan.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-management",
    "archive"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zipeter/dsh-session-admin.git"
  },
  "homepage": "https://github.com/Zipeter/dsh-session-admin#readme",
  "bugs": {
    "url": "https://github.com/Zipeter/dsh-session-admin/issues"
  },
  "author": "Zipeter",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "license": "MIT"
}
